# LLM provider: "openai-compatible" (default; local Ollama / llama.cpp server) or "anthropic"
LLM_PROVIDER=openai-compatible

# --- openai-compatible (local models) ---
# Ollama default; for llama.cpp `llama-server` use http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1
# Required: model name as the server knows it
LLM_MODEL=qwen3:8b
# PrismML Bonsai 27B 1-bit (Ollama with Q1_0 support, verified on 0.40.2; or the name llama-server reports):
# LLM_MODEL=hf.co/prism-ml/Bonsai-27B-gguf:Q1_0
# Optional: local servers ignore it (a placeholder is sent when empty)
LLM_API_KEY=
# Optional: sampling temperature, defaults to 0.5 (Bonsai's recommended value)
LLM_TEMPERATURE=0.5
# Optional: ask the server to skip reasoning (default true): sends chat_template_kwargs (llama.cpp) and reasoning_effort=none (Ollama); <think> blocks are stripped anyway
LLM_DISABLE_THINKING=true

# --- anthropic ---
# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# Optional: local embedding model (Hugging Face id) and cache directory
EMBEDDING_MODEL=Xenova/multilingual-e5-small
TRANSFORMERS_CACHE_DIR=.cache/transformers

# Optional: read-only MCP server (Jira/GitLab). When MCP_SERVER_COMMAND is empty the mock provider is used.
MCP_SERVER_COMMAND=
# Space-separated arguments for the MCP server command
MCP_SERVER_ARGS=
# Remote tool names exposed by your MCP server (only these read-only tools are ever called)
MCP_TOOL_GET_TICKET=get_issue
MCP_TOOL_SEARCH_TICKETS=search_issues
MCP_TOOL_LIST_FAILED_PIPELINES=list_failed_pipelines

# --- Optional settings (defaults shown; uncomment to override) ---
# INDEX_PATH=data/index.json
# PENDING_PATH=data/pending.json
# TRACES_PATH=data/traces.jsonl
# LOG_DIR=data/logs
# RETRIEVAL_DOC_SLOTS=4
# RETRIEVAL_ENGRAM_SLOTS=2
# ENGRAM_REAL=true   # false = index without your real notes (reproducible evals)
# ENGRAM_SAMPLE=true
# ENGRAM_SOURCES_CONFIG=config/engram-sources.local.json
# ENGRAM_EXPORT_DIR=data/engram
# ALLOWED_LINK_HOSTS=   # comma-separated hosts replies may link to
# ASSISTANT_CONCURRENCY=1
# MEMORY_TURNS=6   # 0 disables short-term memory
# SHOW_CITATIONS=false
# LLM_COST_INPUT_PER_MTOK=0   # USD per million input tokens
# LLM_COST_OUTPUT_PER_MTOK=0  # USD per million output tokens
