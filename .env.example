# Anthropic API (required for `npm run dev` and `npm run eval`)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# Optional: local embedding model (Hugging Face id) and cache directory
EMBEDDING_MODEL=Xenova/multilingual-e5-small
TRANSFORMERS_CACHE_DIR=.cache/transformers

# Optional: read-only MCP server (Jira/GitLab). When MCP_SERVER_COMMAND is empty the mock provider is used.
MCP_SERVER_COMMAND=
# Space-separated arguments for the MCP server command
MCP_SERVER_ARGS=
# Remote tool names exposed by your MCP server (only these read-only tools are ever called)
MCP_TOOL_GET_TICKET=get_issue
MCP_TOOL_SEARCH_TICKETS=search_issues
MCP_TOOL_LIST_FAILED_PIPELINES=list_failed_pipelines
